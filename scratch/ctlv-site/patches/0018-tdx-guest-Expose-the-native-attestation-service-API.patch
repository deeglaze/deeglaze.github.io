+	if (!reportdata || length != TDX_REPORTDATA_LEN || !out || !out_length)
+		return -EINVAL;
 	/*
 	 * If the previous request is timedout or interrupted, and the
 	 * Quote buf status is still in GET_QUOTE_IN_FLIGHT (owned by
